#!/usr/bin/env python
"""
TrackFlow — Pipeline de Telemetría (Fase 2 & 3) — Refactorizado
=================================================================

Aplica el patrón **Divide y Vencerás**: cada fase del pipeline ETL se
aisla en un subflow independiente (`@flow`) que refleja estrictamente
las métricas de negocio que Daniel Espinoza necesita en su dashboard.

Fases:

  [Extracción]
    extract_shipment_volume_from_warehouses
      ─ Lee eventos de `telemetry_events` (simulado con _SAMPLE_EVENTS).

  [Transformación — 5 KPIs ejecutivos]
    calculate_shipping_volume         → Volumen de envíos (total + por almacén)
    calculate_on_time_delivery_rate   → Tasa de entrega a tiempo
    calculate_operational_cost        → Coste operativo estimado
    calculate_returns                 → Métricas de devoluciones
    calculate_customer_satisfaction   → Satisfacción del cliente

    assemble_executive_kpis           → Ensambla los 5 KPIs en el registro final

  [Carga]
    load_executive_kpis               → Persiste con upsert ((fecha_reporte, id_corrida))

  [Opcional]
    notify_pipeline_status            → Snapshot de validación (return_state=True)

Resiliencia:
  - Las tareas de extracción y carga mantienen retries=3 / retry_delay_seconds=10.

Cache:
  - Cada tarea de transformación usa cache_key_fn + cache_expiration=1h,
    evitando recalcular KPIs si el flujo se ejecuta múltiples veces
    sobre el mismo conjunto de eventos.

Idempotencia:
  - La carga simula un upsert basado en (fecha_reporte + id_corrida).

Contrato de salida (compatible con services/reporting/router.py):
  {
    "data": { <ExecutiveKPIs> },
    "table": "executive_kpis",
    "loaded_at": "...",
    "status": "ready",
    "upsert_constraint": { ... },
    "_metadata": { hora_inicio, hora_fin, duracion_segundos, ... }
  }

Ejecución:
    python data/pipelines/pipeline.py
"""

from __future__ import annotations

import json
import logging
import os
from datetime import datetime, timedelta, timezone
from hashlib import sha256
from typing import Any

from prefect import flow, task
from prefect.logging import get_run_logger

# ---------------------------------------------------------------------------
# Configuración de entorno
# ---------------------------------------------------------------------------

PIPELINE_ENV = os.getenv("PIPELINE_ENV", "development")
RAW_DATA_DIR = os.getenv("RAW_DATA_DIR", "data/raw")
PROCESSED_DATA_DIR = os.getenv("PROCESSED_DATA_DIR", "data/process")
TARGET_TABLE = os.getenv("TARGET_TABLE", "executive_kpis")
LOG_LEVEL = os.getenv("LOG_LEVEL", "INFO")

logging.basicConfig(
    level=getattr(logging, LOG_LEVEL.upper(), logging.INFO),
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
)
logger = logging.getLogger("trackflow.pipeline")

# ---------------------------------------------------------------------------
# Simulaciones de datos de entrada  (NO ALTERADA — ingesta original)
# ---------------------------------------------------------------------------

_SAMPLE_EVENTS: list[dict[str, Any]] = [
    {
        "event_id": "ev-001",
        "timestamp": "2026-09-03T08:15:00Z",
        "warehouse": "los-angeles",
        "event_type": "shipment.created",
        "payload": {"shipment_id": "SHP-LA-001", "destination": "CA"},
    },
    {
        "event_id": "ev-002",
        "timestamp": "2026-09-03T08:20:00Z",
        "warehouse": "zaragoza",
        "event_type": "shipment.created",
        "payload": {"shipment_id": "SHP-ZA-001", "destination": "Madrid"},
    },
    {
        "event_id": "ev-003",
        "timestamp": "2026-09-03T09:00:00Z",
        "warehouse": "los-angeles",
        "event_type": "shipment.delivered",
        "payload": {"shipment_id": "SHP-LA-001", "on_time": True},
    },
    {
        "event_id": "ev-004",
        "timestamp": "2026-09-03T09:10:00Z",
        "warehouse": "zaragoza",
        "event_type": "shipment.delivered",
        "payload": {"shipment_id": "SHP-ZA-001", "on_time": False},
    },
    {
        "event_id": "ev-005",
        "timestamp": "2026-09-03T09:30:00Z",
        "warehouse": "los-angeles",
        "event_type": "return.initiated",
        "payload": {"return_id": "RET-LA-001", "reason": "wrong_item"},
    },
    {
        "event_id": "ev-006",
        "timestamp": "2026-09-03T10:00:00Z",
        "warehouse": "zaragoza",
        "event_type": "return.completed",
        "payload": {"return_id": "RET-ZA-001", "condition": "damaged"},
    },
]

# ---------------------------------------------------------------------------
# Helper: cache key genérico para tareas de transformación
# ---------------------------------------------------------------------------


def _metrics_cache_key(task_ctx: Any, inputs: dict[str, Any]) -> str:
    """Genera un hash determinista a partir del nombre de tarea + eventos.

    Incluye task_ctx.task_key en el hash para que CADA tarea tenga
    su propia entrada de caché, evitando colisiones entre los 5 subflows
    de transformación que comparten esta función de cache_key.
    """
    events = inputs.get("events", [])
    sorted_ids = sorted(e["event_id"] for e in events)
    task_key = getattr(task_ctx, "task_key", None) or str(task_ctx)
    raw = f"{task_key},{','.join(sorted_ids)}"
    return sha256(raw.encode("utf-8")).hexdigest()


# ===================================================================
# FASE 1: EXTRACCIÓN  (subflow)
# ===================================================================


@flow(
    name="extract_shipment_volume_from_warehouses",
    description="Lee eventos de telemetría desde los almacenes (Los Ángeles y Zaragoza).",
    log_prints=True,
)
def extract_shipment_volume_from_warehouses() -> list[dict[str, Any]]:
    """Subflow de extracción: obtiene los eventos brutos desde la fuente.

    Mantiene la lógica original de ``extraer_telemetria`` sin alteraciones,
    incluyendo los 3 reintentos para absorber fallos transitorios de red
    de los almacenes.

    Returns:
        Lista de eventos de telemetría (dicts con event_id, warehouse, etc.).
    """
    return _extract_events_task()


@task(
    name="_extract_events_task",
    description="Tarea interna que ejecuta la lectura simulada de eventos.",
    retries=3,
    retry_delay_seconds=10,
)
def _extract_events_task() -> list[dict[str, Any]]:
    """Simula la lectura de eventos de telemetría desde los almacenes.

    Justificación de reintentos:
        Los almacenes de Los Ángeles y Zaragoza operan con sistemas
        independientes y conexiones de red que no siempre son estables.
        Con 3 reintentos y 10s de espera entre ellos absorbemos fallos
        transitorios sin intervención manual.
    """
    log = get_run_logger()
    log.info(
        "Extrayendo eventos de telemetría desde %s (entorno: %s)...",
        RAW_DATA_DIR,
        PIPELINE_ENV,
    )
    events = _SAMPLE_EVENTS.copy()
    log.info("Extraídos %d eventos correctamente.", len(events))
    return events


# ===================================================================
# FASE 2: TRANSFORMACIÓN  —  MÉTRICAS CEO
# ===================================================================
# Cada métrica de negocio que Daniel Espinoza necesita visualizar es un
# subflow independiente con su propia tarea interna cacheada.
# ===================================================================


# ─────────────────────────────────────────────────────────────────────
# Subflow 2a: Volumen de envíos  (Shipping Volume)
# ─────────────────────────────────────────────────────────────────────


@flow(
    name="calculate_shipping_volume",
    description="KPI: Volumen total de envíos y desglose por almacén.",
    log_prints=True,
)
def calculate_shipping_volume(events: list[dict[str, Any]]) -> dict[str, Any]:
    """Calcula el volumen de envíos total y por almacén.

    Args:
        events: Lista de eventos de telemetría.

    Returns:
        Dict con ``total`` (int) y ``por_almacen`` (dict[str, int]).
    """
    return _compute_shipping_volume_task(events)


@task(
    name="_compute_shipping_volume",
    description="Cómputo interno de volumen de envíos (cacheable 1h).",
    cache_key_fn=_metrics_cache_key,
    cache_expiration=timedelta(hours=1),
)
def _compute_shipping_volume_task(events: list[dict[str, Any]]) -> dict[str, Any]:
    """Procesa los eventos ``shipment.created`` y agrupa por almacén."""
    log = get_run_logger()
    created = [e for e in events if e["event_type"] == "shipment.created"]

    total = len(created)
    by_warehouse: dict[str, int] = {}
    for e in created:
        w = e["warehouse"]
        by_warehouse[w] = by_warehouse.get(w, 0) + 1

    result = {"total": total, "por_almacen": by_warehouse}
    log.info("Volumen de envíos → total=%d, por_almacen=%s", total, by_warehouse)
    return result


# ─────────────────────────────────────────────────────────────────────
# Subflow 2b: Tasa de entrega a tiempo  (On-Time Delivery Rate)
# ─────────────────────────────────────────────────────────────────────


@flow(
    name="calculate_on_time_delivery_rate",
    description="KPI: Porcentaje de entregas realizadas a tiempo.",
    log_prints=True,
)
def calculate_on_time_delivery_rate(
    events: list[dict[str, Any]],
) -> dict[str, Any]:
    """Calcula la tasa de entregas a tiempo sobre el total de entregas.

    Args:
        events: Lista de eventos de telemetría.

    Returns:
        Dict con ``porcentaje`` (float), ``entregas_on_time`` (int),
        ``entregas_totales`` (int).
    """
    return _compute_delivery_rate_task(events)


@task(
    name="_compute_delivery_rate",
    description="Cómputo interno de tasa de entrega a tiempo (cacheable 1h).",
    cache_key_fn=_metrics_cache_key,
    cache_expiration=timedelta(hours=1),
)
def _compute_delivery_rate_task(
    events: list[dict[str, Any]],
) -> dict[str, Any]:
    """Examina eventos ``shipment.delivered`` y su flag ``on_time``."""
    log = get_run_logger()
    delivered = [e for e in events if e["event_type"] == "shipment.delivered"]

    total = len(delivered)
    on_time = sum(1 for e in delivered if e["payload"].get("on_time"))
    pct = (on_time / total * 100.0) if total > 0 else 0.0

    result = {
        "porcentaje": round(pct, 2),
        "entregas_on_time": on_time,
        "entregas_totales": total,
    }
    log.info(
        "Tasa de entrega a tiempo → %.2f%% (%d/%d)",
        pct,
        on_time,
        total,
    )
    return result


# ─────────────────────────────────────────────────────────────────────
# Subflow 2c: Coste operativo  (Operational Cost)
# ─────────────────────────────────────────────────────────────────────


@flow(
    name="calculate_operational_cost",
    description="KPI: Coste operativo estimado de la operativa de envíos.",
    log_prints=True,
)
def calculate_operational_cost(events: list[dict[str, Any]]) -> dict[str, Any]:
    """Estima el coste operativo total a partir de los eventos.

    Modelo de costes (business rules):
      - $10.00 por cada shipment.created (handling)
      - $ 5.00 por cada shipment.delivered (delivery)
      - $15.00 por cada return.* (logística inversa)

    Args:
        events: Lista de eventos de telemetría.

    Returns:
        Dict con ``total`` (float), ``desglose`` (dict),
        ``moneda`` (str).
    """
    return _compute_operational_cost_task(events)


@task(
    name="_compute_operational_cost",
    description="Cómputo interno de coste operativo (cacheable 1h).",
    cache_key_fn=_metrics_cache_key,
    cache_expiration=timedelta(hours=1),
)
def _compute_operational_cost_task(
    events: list[dict[str, Any]],
) -> dict[str, Any]:
    """Aplica el modelo de costes unitarios sobre los eventos clasificados."""
    log = get_run_logger()

    created = [e for e in events if e["event_type"] == "shipment.created"]
    delivered = [e for e in events if e["event_type"] == "shipment.delivered"]
    returns = [e for e in events if e["event_type"].startswith("return.")]

    HANDLING_COST = 10.0
    DELIVERY_COST = 5.0
    RETURN_COST = 15.0

    handling_total = len(created) * HANDLING_COST
    delivery_total = len(delivered) * DELIVERY_COST
    returns_total = len(returns) * RETURN_COST
    grand_total = handling_total + delivery_total + returns_total

    result = {
        "total": round(grand_total, 2),
        "desglose": {
            "handling": round(handling_total, 2),
            "delivery": round(delivery_total, 2),
            "returns_reverse_logistics": round(returns_total, 2),
        },
        "moneda": "USD",
        "unidades": {
            "handling_cost_per_shipment": HANDLING_COST,
            "delivery_cost_per_shipment": DELIVERY_COST,
            "return_cost_per_return": RETURN_COST,
        },
    }
    log.info(
        "Coste operativo → $%.2f (handling=$%.2f, delivery=$%.2f, returns=$%.2f)",
        grand_total,
        handling_total,
        delivery_total,
        returns_total,
    )
    return result


# ─────────────────────────────────────────────────────────────────────
# Subflow 2d: Devoluciones  (Returns)
# ─────────────────────────────────────────────────────────────────────


@flow(
    name="calculate_returns",
    description="KPI: Volumen y tasa de devoluciones sobre el total de envíos.",
    log_prints=True,
)
def calculate_returns(events: list[dict[str, Any]]) -> dict[str, Any]:
    """Calcula las métricas de devoluciones.

    Args:
        events: Lista de eventos de telemetría.

    Returns:
        Dict con ``volumen`` (int) y ``tasa_porcentaje`` (float).
    """
    return _compute_returns_task(events)


@task(
    name="_compute_returns",
    description="Cómputo interno de métricas de devoluciones (cacheable 1h).",
    cache_key_fn=_metrics_cache_key,
    cache_expiration=timedelta(hours=1),
)
def _compute_returns_task(events: list[dict[str, Any]]) -> dict[str, Any]:
    """Examina eventos cuyo tipo comienza por ``return.``."""
    log = get_run_logger()

    returns = [e for e in events if e["event_type"].startswith("return.")]
    created = [e for e in events if e["event_type"] == "shipment.created"]

    volume = len(returns)
    total_shipments = len(created)
    rate = (volume / total_shipments * 100.0) if total_shipments > 0 else 0.0

    result = {
        "volumen": volume,
        "tasa_porcentaje": round(rate, 2),
    }
    log.info("Devoluciones → volumen=%d, tasa=%.2f%%", volume, rate)
    return result


# ─────────────────────────────────────────────────────────────────────
# Subflow 2e: Satisfacción del cliente  (Customer Satisfaction)
# ─────────────────────────────────────────────────────────────────────


@flow(
    name="calculate_customer_satisfaction",
    description="KPI: Índice de satisfacción del cliente derivado de entregas y devoluciones.",
    log_prints=True,
)
def calculate_customer_satisfaction(
    events: list[dict[str, Any]],
) -> dict[str, Any]:
    """Estima la satisfacción del cliente en escala 0–100.

    Regla de negocio:
      - Base: 100 puntos.
      - Penalización de 20 puntos por cada entrega fuera de tiempo.
      - Penalización de 10 puntos por cada devolución.
      - El resultado se clamp entre 0 y 100.

    Args:
        events: Lista de eventos de telemetría.

    Returns:
        Dict con ``indice`` (float), ``nivel`` (str), ``penalizaciones`` (dict).
    """
    return _compute_customer_satisfaction_task(events)


@task(
    name="_compute_customer_satisfaction",
    description="Cómputo interno de satisfacción del cliente (cacheable 1h).",
    cache_key_fn=_metrics_cache_key,
    cache_expiration=timedelta(hours=1),
)
def _compute_customer_satisfaction_task(
    events: list[dict[str, Any]],
) -> dict[str, Any]:
    """Aplica el modelo de penalizaciones sobre entregas tardías y devoluciones."""
    log = get_run_logger()

    delivered = [e for e in events if e["event_type"] == "shipment.delivered"]
    returns = [e for e in events if e["event_type"].startswith("return.")]

    late_deliveries = sum(
        1 for e in delivered if not e["payload"].get("on_time")
    )
    total_returns = len(returns)

    LATE_PENALTY = 20.0
    RETURN_PENALTY = 10.0

    raw_score = 100.0 - (late_deliveries * LATE_PENALTY) - (total_returns * RETURN_PENALTY)
    clamped = max(0.0, min(100.0, raw_score))

    if clamped >= 80:
        level = "alta"
    elif clamped >= 50:
        level = "media"
    else:
        level = "baja"

    result = {
        "indice": round(clamped, 2),
        "nivel": level,
        "penalizaciones": {
            "late_deliveries": late_deliveries,
            "returns": total_returns,
        },
        "escala": "0-100",
    }
    log.info(
        "Satisfacción del cliente → índice=%.2f, nivel=%s, "
        "late_deliveries=%d, returns=%d",
        clamped,
        level,
        late_deliveries,
        total_returns,
    )
    return result


# ─────────────────────────────────────────────────────────────────────
# Tarea de ensamblaje: combina los 5 KPIs en el registro final
# ─────────────────────────────────────────────────────────────────────


@task(
    name="assemble_executive_kpis",
    description="Ensambla los 5 KPIs individuales en el registro ejecutivo final.",
)
def assemble_executive_kpis(
    events: list[dict[str, Any]],
    shipping_volume: dict[str, Any],
    on_time_delivery: dict[str, Any],
    operational_cost: dict[str, Any],
    returns: dict[str, Any],
    customer_satisfaction: dict[str, Any],
) -> dict[str, Any]:
    """Combina todos los KPIs en un único registro ``ExecutiveKPIs``.

    Incluye el identificador único de corrida (hash de eventos) y los
    campos de idempotencia (``fecha_reporte``, ``id_corrida``).

    Args:
        events:           Lista original de eventos (para generar el hash).
        shipping_volume:  Resultado de ``calculate_shipping_volume``.
        on_time_delivery: Resultado de ``calculate_on_time_delivery_rate``.
        operational_cost: Resultado de ``calculate_operational_cost``.
        returns:          Resultado de ``calculate_returns``.
        customer_satisfaction: Resultado de ``calculate_customer_satisfaction``.

    Returns:
        Dict con la estructura completa del ExecutiveKPIs.
    """
    log = get_run_logger()

    run_id = sha256(
        str(tuple(sorted(e["event_id"] for e in events))).encode()
    ).hexdigest()[:12]

    now_iso = datetime.now(timezone.utc).isoformat()

    kpis = {
        "fecha_reporte": "2026-09-03",
        "id_corrida": run_id,
        "timestamp": now_iso,
        "periodo": "2026-09-03",
        "volumen_envios": shipping_volume,
        "tasa_entrega_tiempo": on_time_delivery,
        "coste_operativo": operational_cost,
        "devoluciones": returns,
        "satisfaccion_cliente": customer_satisfaction,
    }

    log.info("KPIs ejecutivos ensamblados: %s", json.dumps(kpis, indent=2))
    return kpis


# ===================================================================
# FASE 3: CARGA  (subflow)
# ===================================================================


@flow(
    name="load_executive_kpis",
    description="Prepara la escritura de los KPIs en la tabla destino con upsert.",
    log_prints=True,
)
def load_executive_kpis(kpis: dict[str, Any]) -> dict[str, Any]:
    """Subflow de carga: envuelve la tarea de upsert con retries.

    Args:
        kpis: Registro completo de KPIs ejecutivos.

    Returns:
        Dict con metadatos de la operación de carga.
    """
    return _upsert_kpis_task(kpis)


@task(
    name="_upsert_kpis_task",
    description="Tarea interna que simula el upsert en la tabla destino.",
    retries=3,
    retry_delay_seconds=10,
)
def _upsert_kpis_task(kpis: dict[str, Any]) -> dict[str, Any]:
    """Simula un upsert sobre ``executive_kpis``.

    La idempotencia se garantiza mediante un constraint único compuesto
    por ``fecha_reporte`` + ``id_corrida``.

    Justificación de reintentos:
        Al igual que en extracción, la conexión a la base de datos destino
        puede presentar cortes transitorios. Los reintentos automatizados
        evitan que un pico de latencia detenga el pipeline.
    """
    log = get_run_logger()
    log.info("Preparando carga hacia tabla '%s'...", TARGET_TABLE)

    fecha_reporte = kpis.get("fecha_reporte", "unknown")
    id_corrida = kpis.get("id_corrida", "unknown")

    registro: dict[str, Any] = {
        "table": TARGET_TABLE,
        "data": kpis,
        "loaded_at": datetime.now(timezone.utc).isoformat(),
        "status": "ready",
        "upsert_constraint": {
            "primary_key": ["fecha_reporte", "id_corrida"],
            "values": {
                "fecha_reporte": fecha_reporte,
                "id_corrida": id_corrida,
            },
            "strategy": (
                "INSERT INTO executive_kpis (...) "
                "VALUES (...) "
                f"ON CONFLICT (fecha_reporte, id_corrida) "
                "DO UPDATE SET "
                "  timestamp = EXCLUDED.timestamp,"
                "  volumen_envios = EXCLUDED.volumen_envios,"
                "  tasa_entrega_tiempo = EXCLUDED.tasa_entrega_tiempo,"
                "  coste_operativo = EXCLUDED.coste_operativo,"
                "  devoluciones = EXCLUDED.devoluciones,"
                "  satisfaccion_cliente = EXCLUDED.satisfaccion_cliente,"
                "  loaded_at = EXCLUDED.loaded_at;"
            ),
        },
    }

    log.info("UPSERT simulado sobre (%s, %s)", fecha_reporte, id_corrida)
    log.info(
        "Registro preparado: %s",
        json.dumps(registro, indent=2),
    )
    return registro


# ===================================================================
# SUBFLOW OPCIONAL: Notificación de estado
# ===================================================================


@flow(
    name="notify_pipeline_status",
    description="Snapshot de validación o notificación de estado del pipeline (no crítico).",
    log_prints=True,
)
def notify_pipeline_status(resultado_carga: dict[str, Any]) -> str:
    """Subflow NO crítico: genera un snapshot de validación.

    Invocado con ``return_state=True`` desde el flujo principal, de modo
    que si falla, el pipeline continúa sin interrupción.

    Args:
        resultado_carga: Output de ``load_executive_kpis``.

    Returns:
        "notificacion_enviada" en caso de éxito.
    """
    return _build_notification_task(resultado_carga)


@task(
    name="_build_notification_task",
    description="Tarea interna que construye el snapshot de validación.",
)
def _build_notification_task(resultado_carga: dict[str, Any]) -> str:
    """Construye el snapshot de estado y lo registra en los logs."""
    log = get_run_logger()
    log.info("Generando snapshot de validación...")

    notification: dict[str, Any] = {
        "tipo": "pipeline_snapshot",
        "estado": "completado",
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "registros_cargados": resultado_carga.get("status") == "ready",
        "tabla_destino": resultado_carga.get("table"),
        "upsert_constraint": resultado_carga.get(
            "upsert_constraint", {}
        ).get("primary_key"),
    }

    # ⚠️ Simulación de fallo si la variable de entorno NOTIFY_FAIL está activa
    if os.getenv("NOTIFY_FAIL", "").lower() in ("1", "true", "yes"):
        msg = "Servicio de notificaciones no disponible (simulado)."
        log.error(msg)
        raise RuntimeError(msg)

    log.info("Snapshot generado: %s", json.dumps(notification, indent=2))
    return "notificacion_enviada"


# ===================================================================
# FLUJO PRINCIPAL  —  Orquestador
# ===================================================================


@flow(
    name="trackflow_pipeline_telemetria",
    description="Pipeline ETL de telemetría TrackFlow — Fase 2 & 3 (refactorizado).",
    log_prints=True,
)
def trackflow_pipeline_telemetria() -> dict[str, Any]:
    """Orquestador principal del pipeline de telemetría.

    Aplica Divide y Vencerás coordinando subflows independientes:

      1.  extract_shipment_volume_from_warehouses  (Extracción)
      2.  calculate_shipping_volume                (Transformación: volumen)
      3.  calculate_on_time_delivery_rate          (Transformación: on-time)
      4.  calculate_operational_cost               (Transformación: coste)
      5.  calculate_returns                        (Transformación: devoluciones)
      6.  calculate_customer_satisfaction          (Transformación: satisfacción)
      7.  assemble_executive_kpis                  (Ensamblaje)
      8.  load_executive_kpis                      (Carga)
      9.  notify_pipeline_status (return_state)    (Opcional)

    Returns:
        Dict con la estructura de cargo (``data`` + metadatos de ejecución),
        compatible con el contrato que espera ``services/reporting/router.py``.
    """
    from prefect.context import get_run_context

    flow_logger = get_run_logger()
    hora_inicio = datetime.now(timezone.utc)

    flow_logger.info("═══ Iniciando pipeline de telemetría TrackFlow ═══")
    flow_logger.info(
        "Entorno: %s | Tabla destino: %s | Hora inicio: %s",
        PIPELINE_ENV,
        TARGET_TABLE,
        hora_inicio.isoformat(),
    )

    # ── 1. Extracción ─────────────────────────────────────────────────
    flow_logger.info("─── Fase 1: Extracción ─────────────────────────────")
    raw_events = extract_shipment_volume_from_warehouses()
    registros_extraidos = len(raw_events)
    flow_logger.info("Extracción completada: %d eventos.", registros_extraidos)

    # ── 2. Transformación — 5 KPIs ejecutivos ─────────────────────────
    flow_logger.info("─── Fase 2: Transformación (5 KPIs CEO) ────────────")

    shipping_volume = calculate_shipping_volume(raw_events)
    flow_logger.info("✓ Volumen de envíos: %s", shipping_volume)

    delivery_rate = calculate_on_time_delivery_rate(raw_events)
    flow_logger.info("✓ Tasa de entrega a tiempo: %s", delivery_rate)

    operational_cost = calculate_operational_cost(raw_events)
    flow_logger.info("✓ Coste operativo: %s", operational_cost)

    returns = calculate_returns(raw_events)
    flow_logger.info("✓ Devoluciones: %s", returns)

    satisfaction = calculate_customer_satisfaction(raw_events)
    flow_logger.info("✓ Satisfacción del cliente: %s", satisfaction)

    # ── Ensamblar KPIs ───────────────────────────────────────────────
    flow_logger.info("─── Ensamblaje de KPIs ─────────────────────────────")
    executive_kpis = assemble_executive_kpis(
        events=raw_events,
        shipping_volume=shipping_volume,
        on_time_delivery=delivery_rate,
        operational_cost=operational_cost,
        returns=returns,
        customer_satisfaction=satisfaction,
    )
    flow_logger.info("KPIs ensamblados correctamente.")

    # ── 3. Carga ─────────────────────────────────────────────────────
    flow_logger.info("─── Fase 3: Carga ───────────────────────────────────")
    load_result = load_executive_kpis(executive_kpis)
    flow_logger.info("Carga preparada (estrategia upsert).")

    # ── 4. Notificación NO crítica (return_state=True) ────────────────
    flow_logger.info("─── Notificación (opcional) ─────────────────────────")
    notification_state = notify_pipeline_status.with_options(retries=0)(
        load_result, return_state=True
    )

    errors: list[str] = []
    if notification_state.is_completed():
        flow_logger.info("Notificación enviada correctamente.")
    else:
        msg = str(
            notification_state.message
            or "Error desconocido en notificación"
        )
        flow_logger.warning(
            "La tarea de notificación falló (razón: %s) — "
            "el pipeline principal continúa sin interrupción.",
            msg,
        )
        errors.append(msg)

    # ── Metadata de la corrida ───────────────────────────────────────
    hora_fin = datetime.now(timezone.utc)
    duracion = (hora_fin - hora_inicio).total_seconds()
    estado_final = "Completed"

    flow_logger.info("═══ Pipeline finalizado ═══")
    flow_logger.info("Metadata de la corrida:")
    flow_logger.info("  Hora inicio        : %s", hora_inicio.isoformat())
    flow_logger.info("  Hora fin           : %s", hora_fin.isoformat())
    flow_logger.info("  Duración (seg)     : %.2f", duracion)
    flow_logger.info("  Registros extraídos: %d", registros_extraidos)
    flow_logger.info("  KPIs calculados    : 5 (volumen, on-time, coste, devoluciones, satisfacción)")
    flow_logger.info("  Estado final       : %s", estado_final)

    ctx = get_run_context()
    flow_run_id = ctx.flow_run.id if ctx.flow_run else "N/A"

    # ── Incrustar metadata en el resultado (contrato con router) ──────
    load_result["_metadata"] = {
        "hora_inicio": hora_inicio.isoformat(),
        "hora_fin": hora_fin.isoformat(),
        "duracion_segundos": round(duracion, 2),
        "registros_extraidos": registros_extraidos,
        "estado_final": estado_final,
        "flow_run_id": flow_run_id,
        "errores": errors,
    }

    return load_result


# ===================================================================
# Ejecución CLI
# ===================================================================

if __name__ == "__main__":
    trackflow_pipeline_telemetria()
