# ─────────────────────────────────────────────────────────────────────────
# TrackFlow — Environment variables example
# ─────────────────────────────────────────────────────────────────────────
# Copy this file as .env and fill in your own values.
#   cp .env.example .env
#
# WARNING: Never commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────

# ── Ports ───────────────────────────────────────────────────────────────
PORT_WEBSITE=3000
PORT_BACKOFFICE=3001
PORT_API=8000

# ── API (FastAPI / Flask) ────────────────────────────────────────────────
PORT=8000
TINYDB_PATH=./data/suppliers.json
SQL_URL=postgresql://user:password@host:5432/trackflow
SECRET_KEY=change-me-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Password reset ──────────────────────────────────────────────────────
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ── SendGrid (email delivery) ───────────────────────────────────────────
SENDGRID_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@example.com

# ── GitHub Codespaces (optional) ────────────────────────────────────────
CODESPACE_NAME=
GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN=

# ── Backoffice (Next.js) ────────────────────────────────────────────────
NEXT_PUBLIC_INCIDENTS_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# ── Agent model and telemetry (inject secrets via environment/secret manager) ──
GENERATION_API_KEY=
OPENAI_API_KEY=
GENERATION_BASE_URL=
GENERATION_MODEL_ID=
AGENT_ROUTER_MODEL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Shared Redis-backed limit for authenticated /knowledge/query calls.
REDIS_URL=redis://localhost:6379/0
AGENT_RATE_LIMIT=20
AGENT_RATE_WINDOW_SECONDS=60

# Agent MCP OAuth credentials (never put real values in this file).
MCP_SERVER_URL=
MCP_OAUTH_TOKEN_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_SCOPES=
