# Public addresses used in OAuth discovery and Protected Resource Metadata.
MCP_PUBLIC_URL=https://<codespace>-8001.app.github.dev
KEYCLOAK_PUBLIC_URL=https://<codespace>-8080.app.github.dev
OAUTH_ISSUER_URL=https://<codespace>-8080.app.github.dev/realms/trackflow

# Keycloak development administrator; replace before sharing a deployment.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<development-secret>

# Existing TrackFlow API account for internal calls to authenticated incident routes.
TRACKFLOW_SERVICE_USERNAME=<service-account-email>
TRACKFLOW_SERVICE_PASSWORD=<service-account-password>

# Read the agent client secret from Keycloak and configure these in the API environment.
MCP_OAUTH_TOKEN_URL=https://<codespace>-8080.app.github.dev/realms/trackflow/protocol/openid-connect/token
MCP_OAUTH_CLIENT_ID=trackflow-agent
MCP_OAUTH_CLIENT_SECRET=<client-secret-from-keycloak>
MCP_OAUTH_SCOPES=trackflow:mcp incidents:read inventory:read